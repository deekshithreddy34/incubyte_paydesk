    {
      "name": "02 - Employees",
      "item": [
        {
          "name": "Create employee - saves employeeId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "description": "Creates a new test employee on every run. 5000000 INR minor units = INR 50,000. Initial salary history is created automatically. No delete endpoint exists in the supplied API.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"{{employeeCode}}\",\n  \"name\": \"Postman Test Employee\",\n  \"email\": \"{{employeeEmail}}\",\n  \"countryCode\": \"IN\",\n  \"department\": \"Engineering\",\n  \"level\": \"Junior\",\n  \"salaryMinorUnits\": 5000000,\n  \"currencyCode\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"employeeId\", \"\");",
                  "const suffix = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 24);",
                  "pm.collectionVariables.set(\"employeeCode\", \"PM-\" + suffix.toUpperCase());",
                  "pm.collectionVariables.set(\"employeeEmail\", \"postman-\" + suffix + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Employee created with expected salary\", () => {",
                  " pm.expect(json.data.id).to.be.a(\"string\");",
                  " pm.expect(json.data.salaryMinorUnits).to.eql(5000000);",
                  " pm.expect(json.data.currencyCode).to.eql(\"INR\");",
                  "});",
                  "if (pm.response.code === 201 && json.data && json.data.id) pm.collectionVariables.set(\"employeeId\", json.data.id);"
                ]
              }
            }
          ]
        },
